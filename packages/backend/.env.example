# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sakan_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# App
PORT=3001
NODE_ENV=development

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Google Maps (for geocoding proxy)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Frontend URL (for CORS) — comma-separated list of allowed origins
# Web app runs on 3000, Admin panel on 3002
FRONTEND_URL=http://localhost:3000,http://localhost:3002

# Host activation email (required for sending activation links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=Journey Stay <no-reply@journeystay.com>

# Optional aliases (if you already use EMAIL_* vars)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

HOST_ACTIVATION_SECRET=change-me-host-activation-secret
HOST_ACTIVATION_EXPIRES_IN=24h

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── OPay (Egyptian payment gateway) ──────────────────────────────────────────
OPAY_MERCHANT_ID=your-opay-merchant-id
OPAY_PRIVATE_KEY=OPAYPRV...your-private-key
# sandbox | production
OPAY_ENV=sandbox

# Backend public URL used for OPay callbacks.
# In production set to https://api.yoursite.com/api
# For local testing use an ngrok tunnel: https://xxxx.ngrok.io/api
BACKEND_URL=http://localhost:3001/api

# ─── Stripe (optional — not active by default) ────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
